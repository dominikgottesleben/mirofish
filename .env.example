# ===========================================
# LLM Konfiguration
# ===========================================

# Provider: openai (für OpenAI-kompatible APIs wie Gemini, LM Studio, Ollama)
LLM_PROVIDER=openai

# API-Key des LLM-Anbieters
LLM_API_KEY=your-api-key-here

# Basis-URL der API (leer lassen für OpenAI-Standard)
# Für Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Für LM Studio: http://localhost:1234/v1
# Für Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# Modellname
# Für Gemini: gemini-2.0-flash, gemini-2.0-flash-lite, gemini-3-flash-preview
# Für OpenAI: gpt-4o, gpt-4o-mini
# Für lokale Modelle: llama-3.2, mistral usw.
LLM_MODEL_NAME=gemini-2.0-flash

# ===========================================
# Memory Provider
# ===========================================

# Lokale Markdown-Dateien (kein API-Key nötig):
MEMORY_PROVIDER=obsidian

# Zep Cloud (benötigt ZEP_API_KEY):
# MEMORY_PROVIDER=zep

# ===========================================
# Zep Konfiguration (nur bei MEMORY_PROVIDER=zep)
# ===========================================
ZEP_API_KEY=

# ===========================================
# Server Konfiguration (Optional)
# ===========================================
# FLASK_PORT=5001
# FLASK_DEBUG=True
